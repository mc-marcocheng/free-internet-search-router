# Bootstrap variables only. This file is documentation, not automatically loaded.
# Set these in your process/service environment. Do not put API keys or tokens here.
ROUTER_HOST=127.0.0.1
ROUTER_PORT=9092
# Defaults to the OS user's application-data directory.
# ROUTER_DATABASE=C:/private/router/config.sqlite3
# Optional external base64-encoded 32-byte master-key file, not its contents.
# Leave unset to use the OS credential vault. Restrict permissions to the service.
# ROUTER_KEY_FILE=C:/private/secrets/router-master.key